# SafraOS — ambiente local de desenvolvimento
# Copie para .env (git-ignored). Portas exclusivas do SafraOS: nenhuma
# colide com os demais projetos da máquina (decisão do PI, pergunta única).

# --- Portas publicadas no host ---
SAFRAOS_DB_PORT=5473
SAFRAOS_REDIS_PORT=6383
SAFRAOS_API_PORT=5183
SAFRAOS_WEB_PORT=8183
SAFRAOS_MAILPIT_UI_PORT=8126
SAFRAOS_MAILPIT_SMTP_PORT=1126

# --- PostgreSQL / PostGIS ---
SAFRAOS_DB_USER=safraos
SAFRAOS_DB_PASSWORD=safraos_local_dev
SAFRAOS_DB_NAME=safraos
DATABASE_URL=postgresql+psycopg://safraos:safraos_local_dev@localhost:5473/safraos
APP_DATABASE_URL=postgresql+psycopg://safraos_app:safraos_app_local_dev@localhost:5473/safraos

# --- Redis (broker e backend do Celery) ---
REDIS_URL=redis://localhost:6383/0
CELERY_BROKER_URL=redis://localhost:6383/0
CELERY_RESULT_BACKEND=redis://localhost:6383/1

# --- SMTP (Mailpit em desenvolvimento) ---
SMTP_HOST=localhost
SMTP_PORT=1126
SMTP_FROM=nao-responda@safraos.local

# --- API ---
API_ENV=development
API_LOG_LEVEL=info

# --- Web ---
VITE_API_BASE_URL=http://localhost:5183
